<?xml version="1.0"?>
<robot name="vehicle_4wd">

  <!-- Materials -->
  <material name="body_dark">
    <color rgba="0.20 0.23 0.28 1.0" />
  </material>

  <material name="body_light">
    <color rgba="0.40 0.43 0.48 0.9" />
  </material>

  <material name="tire">
    <color rgba="0.06 0.06 0.06 1.0" />
  </material>

  <material name="tread_mark">
    <color rgba="0.32 0.33 0.36 1.0" />
  </material>

  <material name="ground_surface">
    <color rgba="0.18 0.18 0.18 1.0" />
  </material>

  <material name="obstacle_rock">
    <color rgba="0.86 0.20 0.20 0.7" />
  </material>

  <material name="green">
    <color rgba="0.00 1.00 0.00 1.0" />
  </material>

  <material name="ellipsoid_surface">
    <color rgba="0.76 0.62 0.40 0.55" />
  </material>

  <material name="rim">
    <color rgba="0.80 0.82 0.85 1.0" />
  </material>

  <material name="head_light">
    <color rgba="1.00 0.98 0.85 1.0" />
  </material>

  <material name="brake_light">
    <color rgba="0.95 0.08 0.08 1.0" />
  </material>

  <material name="plate_white">
    <color rgba="0.95 0.95 0.95 1.0" />
  </material>

  <material name="text_black">
    <color rgba="0.10 0.10 0.10 1.0" />
  </material>

  <!-- Root link kept for compatibility -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.04" />
      </geometry>
      <material name="green" />
    </visual>
  </link>

  <!-- Main body (car_frame style) -->
  <link name="car_frame">
    <visual>
      <origin xyz="0.0566667 0 0.12" rpy="0 0 0" />
      <geometry>
        <box size="1.00 0.60 0.22" />
      </geometry>
      <material name="body_light" />
    </visual>

    <!-- Wheel axles -->
    <visual>
      <origin xyz="0.33 0.35 0.06" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.020" length="0.10" />
      </geometry>
      <material name="rim" />
    </visual>

    <visual>
      <origin xyz="0.33 -0.35 0.06" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.020" length="0.10" />
      </geometry>
      <material name="rim" />
    </visual>

    <visual>
      <origin xyz="-0.33 0.35 0.06" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.020" length="0.10" />
      </geometry>
      <material name="rim" />
    </visual>

    <visual>
      <origin xyz="-0.33 -0.35 0.06" rpy="1.5707963 0 0" />
      <geometry>
        <cylinder radius="0.020" length="0.10" />
      </geometry>
      <material name="rim" />
    </visual>

    <!-- Front head lights -->
    <visual>
      <origin xyz="0.564 0.18 0.12" rpy="0 1.5707963 0" />
      <geometry>
        <cylinder radius="0.042" length="0.02" />
      </geometry>
      <material name="head_light" />
    </visual>

    <visual>
      <origin xyz="0.564 -0.18 0.12" rpy="0 1.5707963 0" />
      <geometry>
        <cylinder radius="0.042" length="0.02" />
      </geometry>
      <material name="head_light" />
    </visual>

    <!-- Rear brake lights -->
    <visual>
      <origin xyz="-0.44 0.18 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.010 0.09 0.035" />
      </geometry>
      <material name="brake_light" />
    </visual>

    <visual>
      <origin xyz="-0.44 -0.18 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.010 0.09 0.035" />
      </geometry>
      <material name="brake_light" />
    </visual>

    <!-- Rear license plate -->
    <visual>
      <origin xyz="-0.452 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.010 0.24 0.06" />
      </geometry>
      <material name="plate_white" />
    </visual>


    <collision>
      <origin xyz="0.06 0 0.12" rpy="0 0 0" />
      <geometry>
        <box size="1.02 0.62 0.24" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 0.12" rpy="0 0 0" />
      <mass value="40.0" />
      <inertia ixx="2.6" ixy="0" ixz="0" iyy="4.8" iyz="0" izz="6.0" />
    </inertial>
  </link>

  <joint name="ellipsoid_surface_to_ground" type="fixed">
    <parent link="ellipsoid_surface" />
    <child link="ground" />
    <origin xyz="0 0 0.3000" rpy="0 0 0" />
  </joint>

  <!-- Ground patch under the vehicle (2x vehicle body length) -->
  <link name="ground">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="2.00 1.80 0.005" />
      </geometry>
      <material name="ground_surface" />
    </visual>
  </link>

  <link name="ellipsoid_surface">
    <visual>
      <origin xyz="0 0 -0.002" rpy="0 0 0" />
      <geometry>
        <box size="4.84 4.7916 0.005" />
      </geometry>
      <material name="ellipsoid_surface" />
    </visual>
  </link>

  <joint name="ground_to_car_frame" type="fixed">
    <parent link="ground" />
    <child link="car_frame" />
    <origin xyz="0 0 0.1025" rpy="0 0 0" />
  </joint>

  <!-- Simulation obstacle (fixed curb / step) -->
  <link name="obstacle_rock_01">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.44 0.34 0.08" />
      </geometry>
      <material name="obstacle_rock" />
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <box size="0.44 0.34 0.08" />
      </geometry>
    </collision>
  </link>

  <joint name="obstacle_rock_01_joint" type="fixed">
    <parent link="ground" />
    <child link="obstacle_rock_01" />
    <origin xyz="1.10 0.00 0.00" rpy="0 0 0" />
  </joint>

  <joint name="base_to_ellipsoid_surface" type="fixed">
    <parent link="base_link" />
    <child link="ellipsoid_surface" />
    <origin xyz="0 0 -0.3000" rpy="0 0 0" />
  </joint>

  <!-- Front-left wheel -->
