<?xml version="1.0"?>
<robot name="vehicle_4wd">

  <!-- Materials -->
  <material name="body_dark">
    <color rgba="0.20 0.23 0.28 1.0" />
  </material>

  <material name="body_light">
    <color rgba="0.40 0.43 0.48 0.9" />
  </material>

  <material name="tire">
    <color rgba="0.06 0.06 0.06 1.0" />
  </material>

  <material name="tire_tread_texture">
    <texture filename="textures/tire_tread.png" />
  </material>

  <material name="tread_mark">
    <color rgba="0.32 0.33 0.36 1.0" />
  </material>

  <material name="ground_surface">
    <color rgba="0.18 0.18 0.18 0.7" />
  </material>

  <material name="obstacle_rock">
    <color rgba="0.86 0.20 0.20 0.7" />
  </material>

  <material name="obstacle_rock_blue">
    <color rgba="0.20 0.42 0.90 0.7" />
  </material>

  <material name="obstacle_rock_orange">
    <color rgba="0.95 0.52 0.12 0.8" />
  </material>

  <material name="green">
    <color rgba="0.00 1.00 0.00 1.0" />
  </material>

  <material name="ellipsoid_surface">
    <color rgba="0.76 0.62 0.40 0.55" />
  </material>

  <material name="rim">
    <color rgba="0.80 0.82 0.85 1.0" />
  </material>

