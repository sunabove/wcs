<?xml version="1.0"?>
<robot name="vehicle_4wd">

  <!-- Materials -->
  <material name="body_dark">
    <color rgba="0.20 0.23 0.28 1.0"/>
  </material>

  <material name="body_light">
    <color rgba="0.40 0.43 0.48 1.0"/>
  </material>

  <material name="tire">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="tread_mark">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>

  <material name="rim">
    <color rgba="0.80 0.82 0.85 1.0"/>
  </material>

  <material name="arrow_mark">
    <color rgba="0.95 0.95 0.20 1.0"/>
  </material>

  <material name="head_light">
    <color rgba="1.00 0.98 0.85 1.0"/>
  </material>

  <material name="brake_light">
    <color rgba="0.95 0.08 0.08 1.0"/>
  </material>

  <material name="plate_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="text_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <!-- Root link kept for compatibility -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Main body (car_frame style) -->
  <link name="car_frame">
    <visual>
      <origin xyz="0.0566667 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.00 0.60 0.22"/>
      </geometry>
      <material name="body_light"/>
    </visual>

    <!-- Wheel axles -->
    <visual>
      <origin xyz="0.33 0.35 0.06" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.10"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <visual>
      <origin xyz="0.33 -0.35 0.06" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.10"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <visual>
      <origin xyz="-0.33 0.35 0.06" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.10"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <visual>
      <origin xyz="-0.33 -0.35 0.06" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.10"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <!-- Top direction marker in right-arrow shape on the body surface -->
    <visual>
      <origin xyz="0.0716667 0 0.192" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.02 0.004"/>
      </geometry>
      <material name="arrow_mark"/>
    </visual>

    <visual>
      <origin xyz="-0.0483333 0 0.192" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.02 0.004"/>
      </geometry>
      <material name="arrow_mark"/>
    </visual>

    <visual>
      <origin xyz="0.1616667 0.03 0.192" rpy="0 0 -0.785398"/>
      <geometry>
        <box size="0.10 0.02 0.004"/>
      </geometry>
      <material name="arrow_mark"/>
    </visual>

    <visual>
      <origin xyz="0.1616667 -0.03 0.192" rpy="0 0 0.785398"/>
      <geometry>
        <box size="0.10 0.02 0.004"/>
      </geometry>
      <material name="arrow_mark"/>
    </visual>

    <!-- Front head lights -->
    <visual>
      <origin xyz="0.564 0.18 0.12" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.042" length="0.02"/>
      </geometry>
      <material name="head_light"/>
    </visual>

    <visual>
      <origin xyz="0.564 -0.18 0.12" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.042" length="0.02"/>
      </geometry>
      <material name="head_light"/>
    </visual>

    <!-- Rear brake lights -->
    <visual>
      <origin xyz="-0.44 0.18 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.09 0.035"/>
      </geometry>
      <material name="brake_light"/>
    </visual>

    <visual>
      <origin xyz="-0.44 -0.18 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.09 0.035"/>
      </geometry>
      <material name="brake_light"/>
    </visual>

    <!-- Rear license plate -->
    <visual>
      <origin xyz="-0.452 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.010 0.24 0.06"/>
      </geometry>
      <material name="plate_white"/>
    </visual>


    <collision>
      <origin xyz="0.06 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.02 0.62 0.24"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 0.12" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia ixx="2.6" ixy="0" ixz="0" iyy="4.8" iyz="0" izz="6.0"/>
    </inertial>
  </link>

  <joint name="base_to_car_frame" type="fixed">
    <parent link="base_link"/>
    <child link="car_frame"/>
    <origin xyz="0 0 0.10" rpy="0 0 1.5707963"/>
  </joint>

