[Unit]
Description=FastAPI Uvicorn Service
After=network.target

[Service]
Type=simple
User=www
WorkingDirectory=/home/www/wcs
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 -m uvicorn 300_python.fastapi_main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 5

Restart=always
RestartSec=1
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target