        <box size="3.0 3.0 0.001" />
      </geometry>
      <material name="ellipsoid_material">
        <color rgba="0.1 0.4 0.8 0.5" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0005" rpy="0 0 0" />
      <geometry>
        <box size="3.0 3.0 0.001" />
      </geometry>
    </collision>
  </link>

  <!-- ellipsoid_surface를 부모로 하여 상위에 ground_link를 띄우는 고정 관절 -->
  <joint name="ellipsoid_surface_joint" type="fixed">
    <!-- ground_link가 로봇 높이(0.28m)만큼 위(Z축 양의 방향)에 위치하도록 설정 -->
    <origin xyz="0 0 0.28" rpy="0 0 0" />
    <parent link="ellipsoid_surface" />
    <child link="ground_link" />
  </joint>

