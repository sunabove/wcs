<?xml version="1.0"?>
<robot name="wheel_robot">

	<material name="tire">
		<color rgba="0.06 0.06 0.06 1.0"/>
	</material>

	<material name="tire_rib">
		<color rgba="0.18 0.19 0.21 1.0"/>
	</material>

	<material name="rim">
		<color rgba="0.80 0.82 0.85 1.0"/>
	</material>

	<link name="wheel">
		<visual>
			<origin xyz="0 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.152" length="0.10"/>
			</geometry>
			<material name="tire"/>
		</visual>

		<visual>
			<origin xyz="-0.036 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.160" length="0.012"/>
			</geometry>
			<material name="tire_rib"/>
		</visual>

		<visual>
			<origin xyz="-0.018 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.160" length="0.012"/>
			</geometry>
			<material name="tire_rib"/>
		</visual>

		<visual>
			<origin xyz="0.000 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.160" length="0.012"/>
			</geometry>
			<material name="tire_rib"/>
		</visual>

		<visual>
			<origin xyz="0.018 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.160" length="0.012"/>
			</geometry>
			<material name="tire_rib"/>
		</visual>

		<visual>
			<origin xyz="0.036 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.160" length="0.012"/>
			</geometry>
			<material name="tire_rib"/>
		</visual>

		<visual>
			<origin xyz="0 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.09" length="0.11"/>
			</geometry>
			<material name="rim"/>
		</visual>

		<collision>
			<origin xyz="0 0 0" rpy="0 1.5707963 0"/>
			<geometry>
				<cylinder radius="0.16" length="0.10"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="1.8"/>
			<inertia ixx="0.012" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.020"/>
		</inertial>
	</link>

</robot>
