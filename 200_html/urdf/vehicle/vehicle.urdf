<?xml version="1.0"?>
<robot name="vehicle_4wd">

  <!-- Materials -->
  <material name="body_dark">
    <color rgba="0.20 0.23 0.28 1.0"/>
  </material>

  <material name="body_light">
    <color rgba="0.40 0.43 0.48 1.0"/>
  </material>

  <material name="tire">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="rim">
    <color rgba="0.80 0.82 0.85 1.0"/>
  </material>

  <!-- Root link kept for compatibility -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Main body (car_frame style) -->
  <link name="car_frame">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="1.00 0.60 0.18"/>
      </geometry>
      <material name="body_light"/>
    </visual>

    <visual>
      <origin xyz="0.08 0 0.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.70 0.48 0.14"/>
      </geometry>
      <material name="body_dark"/>
    </visual>

    <visual>
      <origin xyz="0.45 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.56 0.08"/>
      </geometry>
      <material name="body_dark"/>
    </visual>

    <visual>
      <origin xyz="-0.45 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.56 0.08"/>
      </geometry>
      <material name="body_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="1.02 0.62 0.24"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="40.0"/>
      <inertia ixx="2.6" ixy="0" ixz="0" iyy="4.8" iyz="0" izz="6.0"/>
    </inertial>
  </link>

  <joint name="base_to_car_frame" type="fixed">
    <parent link="base_link"/>
    <child link="car_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Front-left wheel -->
  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
      <material name="tire"/>
    </visual>

    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.11"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.020"/>
    </inertial>
  </link>

  <joint name="joint_fl" type="continuous">
    <parent link="car_frame"/>
    <child link="wheel_fl"/>
    <origin xyz="0.33 0.40 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Front-right wheel -->
  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
      <material name="tire"/>
    </visual>

    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.11"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.020"/>
    </inertial>
  </link>

  <joint name="joint_fr" type="continuous">
    <parent link="car_frame"/>
    <child link="wheel_fr"/>
    <origin xyz="0.33 -0.40 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Rear-left wheel -->
  <link name="wheel_rl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
      <material name="tire"/>
    </visual>

    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.11"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.020"/>
    </inertial>
  </link>

  <joint name="joint_rl" type="continuous">
    <parent link="car_frame"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.33 0.40 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Rear-right wheel -->
  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
      <material name="tire"/>
    </visual>

    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.11"/>
      </geometry>
      <material name="rim"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.8"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.020"/>
    </inertial>
  </link>

  <joint name="joint_rr" type="continuous">
    <parent link="car_frame"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.33 -0.40 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- Optional wheel-ground friction tuning for Gazebo -->
  <gazebo reference="wheel_fl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="wheel_fr">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="wheel_rl">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="wheel_rr">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

</robot>
